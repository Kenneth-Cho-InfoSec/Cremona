// The coordinates are axial coordinates in the triangular lattice basis
// e1=(1,0), e2=(1/2,sqrt(3)/2). Thus squared Euclidean distance is
// dx^2 + dx*dy + dy^2, an exact Int64 calculation for this bounded example.
fun squared_distance(dx: Int64, dy: Int64): Int64 {
    dx * dx + dx * dy + dy * dy
}

fun main() {
    // Six unit-neighbor points around the origin: a regular hexagon of side 1.
    // The seventh point is the center.
    val x = vec![1 as Int64, 0, -1, -1, 0, 1, 0]
    val y = vec![0 as Int64, 1, 1, 0, -1, -1, 0]

    var pairs = 0 as Int64
    var contacts = 0 as Int64
    var min_d2 = 100 as Int64
    var max_d2 = 0 as Int64
    var degree = vec![0 as Int64, 0, 0, 0, 0, 0, 0]
    var i = 0 as Int64
    while (i < 7) {
        var j = i + 1
        while (j < 7) {
            val d2 = squared_distance(x[i] - x[j], y[i] - y[j])
            pairs += 1
            if (d2 == 1) {
                contacts += 1
                degree[i] += 1
                degree[j] += 1
            }
            if (d2 < min_d2) { min_d2 = d2 }
            if (d2 > max_d2) { max_d2 = d2 }
            j += 1
        }
        i += 1
    }

    // Output order: unordered pair count, unit-contact count, minimum d^2, max d^2.
    println(pairs)
    println(contacts)
    println(min_d2)
    println(max_d2)
    i = 0
    while (i < 7) {
        println(degree[i])
        i += 1
    }
}
